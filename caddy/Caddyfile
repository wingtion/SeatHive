# The reverse proxy in front of the API: HTTPS, HTTP/3, WebSockets, and an access log without tokens.
#
# SITE_ADDRESS is the API's domain on a server (for example api.seathive.example): Caddy then gets a certificate
# from Let's Encrypt by itself. Without it the site is "localhost", served with Caddy's own local certificate.
#
# Caddy sets X-Forwarded-For and X-Forwarded-Proto itself and ignores what a client sends in X-Forwarded-For,
# so the API, which trusts this proxy's address only, sees the real client address.

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Only the API is behind the proxy. Postgres, Redis and RabbitMQ (its management UI included) are not:
	# they are reachable from inside the compose network only.
	reverse_proxy api:8080

	log {
		output stdout
		format filter {
			wrap json
			fields {
				# A WebSocket to the hub carries the JWT in the address (/hubs/seats?access_token=...).
				# Authorization and Cookie headers are already left out of the log by Caddy.
				request>uri query {
					replace access_token REDACTED
				}
			}
		}
	}
}
