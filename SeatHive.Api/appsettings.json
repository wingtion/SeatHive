{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "SeatHive.Api",
    "Audience": "SeatHive.Client"
  },

  "RateLimiting": {
    "Auth": { "PermitLimit": 10 },
    "Booking": { "PermitLimit": 30 }
  },

  "Holds": {
    "DurationSeconds": 300,
    "MaxActivePerUser": 4,
    "PaymentGraceSeconds": 30,
    "SweepIntervalSeconds": 30
  }
}
