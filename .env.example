# Copy this file to .env and fill in every value. .env is ignored by git; never commit it.
# docker compose reads .env automatically and refuses to start when a required value is missing.
#
# Use long random values made of letters and digits only (for example: openssl rand -hex 32).
# Characters such as ; , = $ and spaces break connection strings or compose substitution.

# PostgreSQL password for the "postgres" user.
POSTGRES_PASSWORD=

# Redis password (requirepass).
REDIS_PASSWORD=

# RabbitMQ user and password. Do not use "guest": RabbitMQ only allows it from localhost.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# JWT signing key. Must be at least 32 bytes long; the API does not start without it.
JWT_KEY=

# Optional. When both are set, this user is created as Admin at startup
# (an existing user with this email is promoted and keeps its password).
# Leave both empty to start without an admin.
# The password must be 8 characters or more and at most 72 bytes.
SEATHIVE_ADMIN_EMAIL=
SEATHIVE_ADMIN_PASSWORD=

# On a server: the API's domain, for example api.seathive.example. Caddy (the reverse proxy) gets its certificate
# from Let's Encrypt by itself; the domain must point at the server and ports 80 and 443 must be open.
# Empty: localhost, with Caddy's own local certificate.
SITE_ADDRESS=

# Optional. The compose network (default 172.28.0.0/24), the address range the other containers get their
# addresses from (default 172.28.0.128/25) and Caddy's fixed address (default 172.28.0.10), which is the only
# address the API takes X-Forwarded-For and X-Forwarded-Proto from. Change them only if that network is already used
# on this machine; then change all three: the range and Caddy's address inside the network, Caddy's outside the range.
COMPOSE_SUBNET=
COMPOSE_IP_RANGE=
CADDY_IP=

# Optional. The origin of the front end that may call the API from a browser, for example https://seathive.example
# (http or https, no wildcard, no path, no trailing "/"; the API does not start otherwise). Use the production
# origin only, not preview deployments. Empty: CORS is off. Local "docker compose up" allows http://localhost:5173 itself.
CORS_ALLOWED_ORIGIN=

# Optional. The time of day in UTC, as HH:mm (for example 03:00), at which the demo data is reset every night:
# all bookings are deleted, the event gets its 100 free seats back, and guests whose token ran out are removed.
# For a public deployment that is always on. Empty: no nightly reset, only the admin's.
DEMO_RESET_DAILY_AT_UTC=

# Local development without docker for the API and Worker ("dotnet run") uses user-secrets instead:
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=seathivedb;Username=postgres;Password=<POSTGRES_PASSWORD>" --project SeatHive.Api
#   dotnet user-secrets set "ConnectionStrings:Redis" "localhost:6379,password=<REDIS_PASSWORD>" --project SeatHive.Api
#   dotnet user-secrets set "Jwt:Key" "<JWT_KEY>" --project SeatHive.Api
#   dotnet user-secrets set "RabbitMQ:Username" "<RABBITMQ_USER>" --project SeatHive.Api
#   dotnet user-secrets set "RabbitMQ:Password" "<RABBITMQ_PASSWORD>" --project SeatHive.Api
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=seathivedb;Username=postgres;Password=<POSTGRES_PASSWORD>" --project SeatHive.Worker
#   dotnet user-secrets set "RabbitMQ:Username" "<RABBITMQ_USER>" --project SeatHive.Worker
#   dotnet user-secrets set "RabbitMQ:Password" "<RABBITMQ_PASSWORD>" --project SeatHive.Worker
