# Line endings: LF in the repository and in every checkout, whatever the platform or core.autocrlf says.
# Docker builds, mounted config files and the CI runner read the working tree, so it has to be LF there too.
* text=auto eol=lf

# Read by Linux tools (containers, the server, CI): always LF, even if git's text detection would guess otherwise.
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env* text eol=lf
*.conf text eol=lf

# Windows-only scripts: CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary: never converted, no text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
*.dll binary
*.exe binary
*.pfx binary
*.snk binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Vendored skills: left out of GitHub's language statistics.
.claude/** linguist-vendored
.impeccable/** linguist-vendored
